{
  "name": "Monitoring backup",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "backup-status",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Backup Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "backup-status"
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "cond-error",
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "error",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if",
      "name": "Erreur ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "fromEmail": "={{ $vars.SMTP_USER }}",
        "toEmail": "={{ $vars.SMTP_USER }}",
        "subject": "⚠️ Backup {{ $json.body.type }} échoué",
        "text": "Le backup {{ $json.body.type }} a échoué.\nFichier : {{ $json.body.file }}\n\nVérifiez les logs : docker exec backup-cron cat /backups/backup.log"
      },
      "id": "node-email",
      "name": "Envoyer alerte",
      "type": "n8n-nodes-base.sendEmail",
      "typeVersion": 2,
      "position": [720, 180]
    }
  ],
  "connections": {
    "Backup Status": {
      "main": [[{ "node": "Erreur ?", "type": "main", "index": 0 }]]
    },
    "Erreur ?": {
      "main": [
        [{ "node": "Envoyer alerte", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": []
}
